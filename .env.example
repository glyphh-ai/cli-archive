# Copy to .env for local dev. These point the TUI at your local stack instead of
# the public control plane (https://api.glyphh.ai).

# The control-plane server the TUI talks to.
GLYPHH_SERVER_URL=http://127.0.0.1:4000

# Lend the desktop app's local MCP server (glyphh_* tools) to the loop — the
# desktop sets both when it opens this loop in a terminal card.
# GLYPHH_APP_MCP_URL=http://127.0.0.1:<port>/mcp
# GLYPHH_APP_MCP_TOKEN=glyphh_…
