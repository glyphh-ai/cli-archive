# Copy to .env for local dev. These point the TUI at your local stack instead of
# the public control plane (https://api.glyphh.ai).

# The control-plane server the TUI talks to.
GLYPHH_SERVER_URL=http://127.0.0.1:3001

# The rotor (agent loop) new sessions run.
# GLYPHH_ROTOR=default

# Path to the openrotor executable the local runtime supervisor spawns (dev).
# GLYPHH_ROTOR_BIN=/abs/path/to/openrotor/dist/cli.js
